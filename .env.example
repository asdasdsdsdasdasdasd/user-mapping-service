# Copy this file to .env and fill in real values.
# .env is git-ignored and must never be committed.

# --- Application ---
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api

# --- MySQL 8 ---
# DB_TYPE=better-sqlite3 is only meant for local experimentation
# (for example DB_DATABASE=:memory: with DB_SYNCHRONIZE=true); use mysql everywhere else.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app
DB_PASSWORD=change-me
DB_DATABASE=user_mapping
# Schema is owned by the migrations - never enable this outside tests.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10

# --- Redis ---
# Leave REDIS_URL empty to run without Redis: MySQL stays the source of truth
# and the service keeps behaving correctly, only without the cache and the lock.
REDIS_URL=redis://localhost:6379
# With authentication: REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_KEY_PREFIX=user-mapping:
REDIS_CACHE_TTL_SECONDS=900
REDIS_LOCK_TTL_MS=5000

# --- docker-compose only ---
# Used to initialise the MySQL container on its first start.
MYSQL_ROOT_PASSWORD=change-me-root
APP_PORT=3000
