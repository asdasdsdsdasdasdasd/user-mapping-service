# Copy this file to .env and fill in real values - .env is git-ignored and must
# never be committed.
#
# The passwords below are intentionally left empty. There are no default
# credentials anywhere in this project: docker compose refuses to start until
# DB_PASSWORD and MYSQL_ROOT_PASSWORD are set, and the application only starts
# when its MySQL configuration is complete.
#
# Generate a password with:  openssl rand -base64 24

# --- Application ---
NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api

# --- MySQL 8 ---
# DB_TYPE=better-sqlite3 is only meant for local experimentation
# (for example DB_DATABASE=:memory: with DB_SYNCHRONIZE=true); use mysql everywhere else.
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=app
DB_PASSWORD=
DB_DATABASE=user_mapping
# The schema is owned by the migrations - never enable this outside tests.
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_POOL_SIZE=10

# --- Redis ---
# Leave REDIS_URL empty to run without Redis: MySQL stays the source of truth
# and the service keeps behaving correctly, only without the cache and the lock.
# This value is used for local development; docker compose always connects the
# API to its own "redis" service.
REDIS_URL=redis://localhost:6379
# Optional. When set, the API authenticates with it and (under compose) Redis is
# started with --requirepass.
REDIS_PASSWORD=
REDIS_KEY_PREFIX=user-mapping:
REDIS_CACHE_TTL_SECONDS=900
REDIS_LOCK_TTL_MS=5000

# --- docker-compose only ---
# Required by docker compose: it initialises the MySQL container on first start.
MYSQL_ROOT_PASSWORD=
APP_PORT=3000
